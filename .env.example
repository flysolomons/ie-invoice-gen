# Neon Postgres connection string (pooled is fine)
DATABASE_URL=
# Neon Auth (Managed Better Auth): Console > Auth > Configuration
NEON_AUTH_BASE_URL=
# 32+ random chars: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NEON_AUTH_COOKIE_SECRET=
APP_URL=http://localhost:3000

# Microsoft sign-in (configure the provider in Neon Console > Auth first)
AUTH_MICROSOFT_ENABLED=false
# Verified Microsoft users with these email domains join automatically as members
ALLOWED_EMAIL_DOMAINS=flysolomons.com,flysolomons.com.sb

# console | resend | smtp
EMAIL_PROVIDER=console
EMAIL_FROM="Invoices <invoices@example.com>"

# local | vercel-blob. Leave blank to auto-pick: vercel-blob when BLOB_READ_WRITE_TOKEN is set.
STORAGE_DRIVER=
BLOB_READ_WRITE_TOKEN=

# Used by `npm run seed` to create the first owner account
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_OWNER_NAME=
